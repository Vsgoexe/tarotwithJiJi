# Runtime & Environment
NODE_ENV=production
PAYMENT_PROVIDER=manual_upi
ENABLE_USD_PAYMENTS=false

# Site & Admin
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ADMIN_EMAIL=
OWNER_EMAIL=
READER_TIMEZONE=Asia/Kolkata
MEETING_URL=

# Manual UPI Configuration (Required when PAYMENT_PROVIDER=manual_upi)
UPI_ID=
UPI_PAYEE_NAME="Tarot with Jiji"

# Database & Storage (Supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email Notifications (Resend)
RESEND_API_KEY=
EMAIL_FROM="Tarot with Jiji <hello@yourdomain.com>"

# Razorpay (Kept for future activation when PAYMENT_PROVIDER=razorpay)
RAZORPAY_KEY_ID=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Scheduling & System
MIN_NOTICE_HOURS=12
MAX_DAYS_AHEAD=60
SLOT_BUFFER_MINUTES=30
CRON_SECRET=
